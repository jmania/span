#!/bin/sh
set -eu

project_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
command=${1:-help}
if [ "$#" -gt 0 ]; then shift; fi

case "$command" in
  extract)
    cd "$project_dir"
    build_dir="$project_dir/.build/standalone"
    binary="$build_dir/summit-export"
    newest_source=$(find Sources/SummitExporter -type f -name '*.swift' -newer "$binary" 2>/dev/null | head -n 1 || true)
    if [ ! -x "$binary" ] || [ -n "$newest_source" ]; then
      mkdir -p "$build_dir/module-cache" "$build_dir/clang-cache"
      export SWIFT_MODULECACHE_PATH="$build_dir/module-cache"
      export CLANG_MODULE_CACHE_PATH="$build_dir/clang-cache"
      source_files="Sources/SummitExporter/Attendee.swift Sources/SummitExporter/AXClient.swift Sources/SummitExporter/main.swift"
      if ! swiftc $source_files -framework AppKit -framework ApplicationServices -o "$binary"; then
        if [ "$(uname -m)" = "arm64" ]; then
          echo "Native build failed; retrying with the Intel SDK slice available on this Mac…" >&2
          swiftc -target x86_64-apple-macosx13.0 $source_files -framework AppKit -framework ApplicationServices -o "$binary"
        else
          exit 1
        fi
      fi
    fi
    exec "$binary" "$@"
    ;;
  match|review)
    cd "$project_dir"
    exec python3 -m summit_network "$command" "$@"
    ;;
  help|-h|--help)
    cat <<'EOF'
Usage: ./bin/summit-network COMMAND [options]

Commands:
  extract   Read attendees from the open Summit app into a CSV
  match     Match attendees against your LinkedIn Connections.csv
  review    Open the private browser review queue for remaining people

Run ./bin/summit-network COMMAND --help for command-specific options.
EOF
    ;;
  *)
    echo "Unknown command: $command" >&2
    exit 2
    ;;
esac
